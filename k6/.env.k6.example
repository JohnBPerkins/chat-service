# k6 Load Test Configuration
# Copy this file to .env.k6 and fill in your values
# Run: cp k6/.env.k6.example k6/.env.k6

# Base URL for WebSocket connection
BASE_URL=wss://chat-service-production.up.railway.app

# Test conversation ID (create a test conversation first)
CONVERSATION_ID=

# JWT token for authentication (get from browser DevTools)
JWT_TOKEN=

# Optional: Multiple user tokens for distributed load
# JWT_1=
# JWT_2=
# JWT_3=

# Optional: Grafana Cloud k6 configuration
# K6_CLOUD_TOKEN=
# K6_CLOUD_PROJECT_ID=

# Test parameters
MESSAGES_PER_VU=100
MESSAGE_SIZE=100
THINK_TIME_MS=1000
