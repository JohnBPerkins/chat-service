# k6 Load Test Configuration
# Copy this file to .env.k6 and fill in your values
# Run: cp k6/.env.k6.example k6/.env.k6

# Base URL for WebSocket connection
BASE_URL=wss://chatservicews.up.railway.app

# Your email address (used as userId)
USER_ID=your-email@example.com

# Test conversation ID (create a test conversation first)
CONVERSATION_ID=

# Grafana Cloud k6 configuration (for cloud testing)
# Get token from: https://app.k6.io/account/api-token
# K6_CLOUD_TOKEN=your-token-here

# Optional: Project ID (k6 will use your default project if not set)
# K6_CLOUD_PROJECT_ID=4928383

# Test parameters
MESSAGES_PER_VU=100
MESSAGE_SIZE=100
THINK_TIME_MS=1000
