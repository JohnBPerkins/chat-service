# Railway Environment Configuration Template
# Copy these to your Railway project's environment variables

# Server Configuration
PORT=8080

# Database Configuration
# Option 1: Railway MongoDB format (manual configuration)
# MONGODB_URI=mongodb://mongo:${{MONGOPASSWORD}}@${{MONGO_HOST}}:${{MONGO_PORT}}/railway

# Option 2: Railway service references (recommended - auto-generated)
MONGODB_URI=${{MONGO_URL}}
DATABASE_NAME=chat_service

# NATS Configuration (optional - for real-time features)
NATS_URL=nats://nats.railway.internal:4222

# CORS Configuration
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://chatservicefront.vercel.app,http://localhost:3000
# NATS_URL=${{NATS_URL}}